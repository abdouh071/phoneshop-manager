{
  "name": "phone-shop-manager",
  "private": true,
  "version": "1.1.0",
  "description": "PhoneShop Manager Pro — Complete phone repair shop POS, inventory, repairs, and thermal printing management system",
  "author": "PhoneShop Manager Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "print-server": "cd print-server && node server.js",
    "test:print-server": "cd print-server && node --test security.test.js",
    "test:electron": "node --test electron/security.test.cjs electron/updater.test.cjs",
    "check:print-sync": "diff -q print-server/print-raw.ps1 electron/print-raw.ps1",
    "sync:print-script": "cp print-server/print-raw.ps1 electron/print-raw.ps1",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:mac:arm64": "electron-builder --mac --arm64",
    "electron:build:mac:intel": "electron-builder --mac --x64",
    "electron:build:win": "electron-builder --win --x64",
    "electron:build:win7": "electron-builder --win --ia32 -c.electronVersion=22.3.27 -c.directories.output=../releases/win7-ia32"
  },
  "build": {
    "appId": "com.automanager.phoneshop",
    "productName": "PhoneShop Manager Pro",
    "directories": {
      "output": "../releases"
    },
    "mac": {
      "category": "public.app-category.business",
      "artifactName": "PhoneShopPro-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "artifactName": "PhoneShopPro-Setup-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "!dist/downloads/**",
      "electron/**/*",
      "print-server/**/*"
    ],
    "extraResources": [
      {
        "from": "print-server/server.js",
        "to": "print-server/server.js"
      },
      {
        "from": "print-server/print-raw.ps1",
        "to": "print-server/print-raw.ps1"
      },
      {
        "from": "print-server/package.json",
        "to": "print-server/package.json"
      },
      {
        "from": "print-server/.env",
        "to": "print-server/.env"
      },
      {
        "from": "print-server/node_modules",
        "to": "print-server/node_modules",
        "filter": [
          "**/*",
          "!.cache/**",
          "!.bin/**"
        ]
      },
      {
        "from": "electron/print-raw.ps1",
        "to": "scripts/print-raw.ps1"
      }
    ],
    "asarUnpack": [
      "print-server/**/*",
      "electron/print-raw.ps1"
    ]
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.23.0",
    "node-thermal-printer": "^4.6.1",
    "papaparse": "^5.5.4",
    "pngjs": "^7.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  }
}
