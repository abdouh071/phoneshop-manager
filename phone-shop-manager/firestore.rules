rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's profile from Firestore to check their role
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && callerProfile().role == 'admin';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        callerProfile().isSuperAdmin == true || 
        callerProfile().role == 'admin' ||
        request.auth.token.email == 'admin@example.com'
      );
    }

    // ─── Inventory & Products ──────────────────────────────────────────────────
    // All signed-in users can read & write (Admin Unlock modal handles frontend guard).
    // Field-level checks cannot mirror the per-user permission flags the app actually uses
    // (`permissions.inventory_edit`, `permissions.pos` stock writes), so tightening writes
    // beyond "signed-in" belongs in Cloud Functions, not here.
    match /inventory/{docId} {
      allow read, write: if isSignedIn();
    }

    // The technician app still resolves a part by trying `inventory` first and falling
    // back to `products` (posStore, stockService, the admin stock KPIs), so this needs the
    // same policy as inventory — the catch-all at the bottom would otherwise deny the
    // phone's whole product catalogue and every stock write that lands there.
    match /products/{docId} {
      allow read, write: if isSignedIn();
    }

    // ─── Transactions ────────────────────────────────────────────────────────
    // All signed-in users can create/read. Nobody can ever delete a transaction.
    match /transactions/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // refunds & edits (status/settlement updates)
      allow delete: if false;        // permanently prohibited
    }

    // ─── Repairs ─────────────────────────────────────────────────────────────
    // Signed-in staff read and write every repair.
    // An unauthenticated caller may only run the customer tracking lookup, which asks for
    // one ticket by ticketNumber with limit(1). A probe against the live database showed
    // `limit <= 5` was not enough: an unauthenticated list with no filter at all returned
    // five full tickets - names, phone numbers, devices and lock codes - and startAfter on
    // the last one walks the whole collection. Rules cannot read the client's `where`
    // values, so capping the page to exactly 1 only slows that walk; it does not close it.
    // The read of an arbitrary document by id is refused outright.
    // Closing this properly needs a sanitized public mirror (a small per-ticket doc with
    // status only), which the Spark plan has to build from the client, not from Functions.
    match /repairs/{docId} {
      allow read:                   if isSignedIn();
      allow list:                   if isSignedIn() || request.query.limit == 1;
      allow create, update, delete: if isSignedIn();
    }

    // ─── Counters (for sequential numbers like TKT-XXXX) ──────────────────────
    match /counters/{docId} {
      allow read, write: if isSignedIn();
    }

    // ─── Customers ───────────────────────────────────────────────────────────
    // Strictly authenticated staff access only
    match /customers/{docId} {
      allow read, create, update: if isSignedIn();
      allow delete:               if isAdmin() || isSuperAdmin();
    }

    // ─── Customer Debts & Credit Tabs ────────────────────────────────────────
    // Strictly authenticated staff access only
    match /customer_debts/{docId} {
      allow read, create, update: if isSignedIn();
      allow delete:               if isAdmin() || isSuperAdmin();
    }

    // ─── Customer Activity Logs ──────────────────────────────────────────────
    // Immutable audit trail for customer ledger & events.
    // The only permitted edit is re-pointing a log at another customer id, which is what
    // merging two duplicate customers does; amounts, actions and timestamps stay frozen.
    match /customer_activity_logs/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerId', 'customerName']);
      allow delete: if false;
    }

    // ─── Activity Logs ───────────────────────────────────────────────────────
    // Anyone signed-in can create; the trail cannot be edited by anyone.
    // Deletion exists only as the admin retention purge, and only for logs that are already
    // past the window it keeps. The window is 85 days rather than the purge's 90 so a till
    // with a slightly fast clock does not fail the whole batch.
    match /activityLogs/{docId} {
      allow read:          if isSignedIn();
      allow create:        if isSignedIn();
      allow update:        if false;
      allow delete:        if (isAdmin() || isSuperAdmin()) &&
        resource.data.timestamp < request.time - duration.value(85, 'd');
    }

    // ─── Purchasing & Suppliers ──────────────────────────────────────────────
    match /suppliers/{docId} {
      allow read, write: if isSignedIn();
    }

    match /purchaseOrders/{docId} {
      allow read, write: if isSignedIn();
    }

    // ─── Restock & Write-Off Logs ────────────────────────────────────────────
    match /restockLogs/{docId} {
      allow read:          if isSignedIn();
      allow create:        if isSignedIn();
      allow update, delete: if false;
    }

    match /writeOffLogs/{docId} {
      allow read:          if isSignedIn();
      allow create:        if isSignedIn();
      allow update, delete: if false;
    }

    // ─── User Profiles ───────────────────────────────────────────────────────
    // Workers can only read. Only admins/superadmins can write.
    // Strict rules prevent privilege escalation:
    //   - Nobody can grant isSuperAdmin via the API (only existing super admins can)
    //   - Regular admins cannot promote anyone to admin role
    match /users/{userId} {
      // Anyone signed-in can read staff profiles (needed for listings)
      allow read: if isSignedIn();

      // Prevent privilege escalation on creation:
      // Non-admins can only create non-admin profiles for their own UID
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isAdmin() ||
        (request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false))
      );

      // Updates:
      // 1. Super Admins can do anything
      // 2. Admins can edit with strict guards (cannot grant superadmin or promote to admin)
      // 3. Workers can self-update personal fields (pushToken, preferredLanguage, avatar)
      //    WITHOUT being able to alter role, permissions, isSuperAdmin, or approvalPin
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && (
          !('isSuperAdmin' in request.resource.data && request.resource.data.isSuperAdmin == true) &&
          !('role' in request.resource.data && request.resource.data.role == 'admin') &&
          !(resource != null && resource.data.isSuperAdmin == true)
        )) ||
        (request.auth.uid == userId && (
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false) &&
          (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions) &&
          (!('approvalPin' in request.resource.data) || request.resource.data.approvalPin == resource.data.approvalPin)
        ))
      );

      // Only Super Admins can delete user profiles
      allow delete: if isSignedIn() && isSuperAdmin();
    }

    // ─── Active & Suspended Carts ────────────────────────────────────────────
    // Signed-in users can read/write their own active & suspended carts
    match /carts/{docId} {
      allow read, write: if isSignedIn();
    }

    match /suspended_carts/{docId} {
      allow read, write: if isSignedIn();
    }

    match /parts_suspended_carts/{docId} {
      allow read, write: if isSignedIn();
    }

    // ─── Settings ────────────────────────────────────────────────────────────
    // `settings/general` is the single document the customer tracking page reads without a
    // session (store name, currency, WhatsApp contact). Other settings documents, and any
    // unauthenticated listing of the collection, require a signed-in staff session.
    // Only Admins/SuperAdmins can WRITE settings (changing IP config etc.)
    match /settings/general {
      allow get: if true;
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ─── Approval Requests ────────────────────────────────────────────────────
    // Signed-in staff can create pending requests; only admins can resolve/approve/reject them
    match /approvalRequests/{docId} {
      allow read: if isSignedIn();
      // Workers can only create pending requests for their own account
      allow create: if isSignedIn() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedBy.uid == request.auth.uid;
      // Only admins or superadmins can approve/reject. Requesters can only cancel their own pending request.
      allow update: if isSignedIn() && (
        isAdmin() || isSuperAdmin() ||
        (request.resource.data.status == 'cancelled' && resource.data.requestedBy.uid == request.auth.uid)
      );
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ─── End Of Day ──────────────────────────────────────────────────────────
    // Sealing a day runs on whichever till is open, by hand or at midnight, so any signed-in
    // user may create one. A sealed record is not meant to be rewritten: staff may only edit
    // `notes`, while admins (who also run backup restore) may correct a record.
    match /end_of_day/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isSuperAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']);
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ─── Remote Print Queue ──────────────────────────────────────────────────
    // One device pushes a job, the till that owns the printer claims it and reports the
    // outcome. Both are signed-in sessions. Without these rules the queue listener was
    // denied on every mount and remote printing never ran.
    match /printQueue/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // pending -> processing -> completed / failed
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ─── Server-Side Enforcement (Cloud Functions) ───────────────────────────
    // Written only by the functions, which hold admin privileges and bypass these rules.
    // A till may read its violations but never write one, or the log stops being evidence.
    match /moneyPathViolations/{docId} {
      allow read:  if isAdmin() || isSuperAdmin();
      allow write: if false;
    }

    // The per-date lock that keeps "one seal per day" true even when two tills close at once.
    match /eod_seal_locks/{date} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ─── Deny Everything Else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
