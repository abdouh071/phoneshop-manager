rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's profile from Firestore to check their role
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && callerProfile().role == 'admin';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        callerProfile().isSuperAdmin == true ||
        callerProfile().role == 'admin' ||
        request.auth.token.email == 'admin@example.com'
      );
    }

    // ─── Permission flags (one contract with both apps) ─────────────────────
    // Desktop `usePermissions` and mobile `effectivePermissions` agree: admins
    // hold every flag; a stored `permissions` map overrides the role preset key
    // by key (only explicit booleans count); anything unstated falls back to the
    // preset. hasPerm mirrors that, so a capability revoked in the staff editor
    // is revoked at the database too. The profile is read once per helper call.
    //
    // What rules cannot mirror: the device-side admin unlocks (password typed
    // at the till, approval answered on the phone). The write still runs under
    // the asking staffer's session and carries no artifact of the unlock, so
    // the unions below admit every role that can legitimately reach the write;
    // the unlock itself remains a workflow guard. Field-level money invariants
    // (totals, refund arithmetic) belong in Cloud Functions, not rules.

    function hasPerm(p, key) {
      return p.role == 'admin' || (
        ('permissions' in p && p.permissions is map && key in p.permissions && p.permissions[key] is bool)
          ? p.permissions[key] == true
          : (
              (p.role == 'sales_agent' && key in ['dashboard', 'pos', 'inventory_products', 'customers']) ||
              (p.role == 'repair_agent' && key in ['dashboard', 'repairs', 'repair_add', 'repair_edit', 'repair_status', 'repair_assign', 'inventory_parts', 'parts_sell', 'customers'])
            )
      );
    }

    function canSell(p) {
      return hasPerm(p, 'pos') || hasPerm(p, 'parts_sell');
    }

    function canWorkRepairs(p) {
      return hasPerm(p, 'repair_add') || hasPerm(p, 'repair_edit') ||
             hasPerm(p, 'repair_status') || hasPerm(p, 'repair_assign');
    }

    function canViewInventory(p) {
      return hasPerm(p, 'inventory_products') || hasPerm(p, 'inventory_parts');
    }

    function canManageDebt(p) {
      return hasPerm(p, 'customers_debt');
    }

    function canViewCustomers(p) {
      return hasPerm(p, 'customers');
    }

    // ─── Inventory & Products ──────────────────────────────────────────────────
    // Writes follow the verified flows of both apps:
    //  - create: the desktop add button sits behind the inventory_edit unlock
    //    (a page viewer may unlock it with the admin password); the phone
    //    requires inventory_edit outright.
    //  - update: stock moves ride on sales (pos/parts_sell), parts allocation
    //    (repair_edit), restock/reception/stocktake (inventory_edit); a price
    //    edit approved on the device is applied by the asking staffer, who may
    //    only hold the inventory view flag — so update admits that union.
    //  - delete: the edit panels, behind the same unlock as create.
    // A dashboard/reports-only account can no longer touch the shelf.
    match /inventory/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() &&
        (hasPerm(callerProfile(), 'inventory_edit') || canViewInventory(callerProfile()));
      allow update: if isSignedIn() &&
        (canSell(callerProfile()) || hasPerm(callerProfile(), 'inventory_edit') ||
         canViewInventory(callerProfile()) || hasPerm(callerProfile(), 'repair_edit'));
      allow delete: if isSignedIn() &&
        (hasPerm(callerProfile(), 'inventory_edit') || canViewInventory(callerProfile()));
    }

    // The technician app still resolves a part by trying `inventory` first and falling
    // back to `products` (posStore, stockService, the admin stock KPIs), so this needs the
    // same policy as inventory — the catch-all at the bottom would otherwise deny the
    // phone's whole product catalogue and every stock write that lands there.
    match /products/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() &&
        (hasPerm(callerProfile(), 'inventory_edit') || canViewInventory(callerProfile()));
      allow update: if isSignedIn() &&
        (canSell(callerProfile()) || hasPerm(callerProfile(), 'inventory_edit') ||
         canViewInventory(callerProfile()) || hasPerm(callerProfile(), 'repair_edit'));
      allow delete: if isSignedIn() &&
        (hasPerm(callerProfile(), 'inventory_edit') || canViewInventory(callerProfile()));
    }

    // ─── Transactions ────────────────────────────────────────────────────────
    // Sellers ring, refund, edit and stamp invoices (the phone's void-request and
    // sale-effect stamps ride the same flags); repair settlement never writes here
    // — it writes debts — so repair-only and view-only roles stay out.
    // Nobody can ever delete a transaction.
    match /transactions/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && canSell(callerProfile());
      allow update: if isSignedIn() && canSell(callerProfile());
      allow delete: if false;        // permanently prohibited
    }

    // ─── Repairs ─────────────────────────────────────────────────────────────
    // Signed-in staff read and write every repair; anonymous callers get nothing.
    // The old `list if limit == 1` escape existed for the customer tracking lookup,
    // but a live probe showed an unauthenticated list with no filter at all walked
    // full tickets — names, phone numbers, devices and lock codes — one page at a
    // time. Rules cannot read the client's `where` values, so no page cap closes
    // that walk. The public tracking page now reads the sanitized mirror below.
    match /repairs/{docId} {
      allow read:                   if isSignedIn();
      // Counter staff also create tickets from a customer profile (new phone →
      // new ticket) and edit or delete a device's tickets from there, so the
      // customers flag joins the repair flags on writes.
      allow create:                 if isSignedIn() &&
        (hasPerm(callerProfile(), 'repair_add') || canViewCustomers(callerProfile()));
      allow update, delete:         if isSignedIn() &&
        (canWorkRepairs(callerProfile()) || canViewCustomers(callerProfile()));
    }

    // ─── Public tracking mirror ────────────────────────────────────────────────
    // One sanitized display-fields-only document per trackable ticket, written by
    // both apps on every repair mutation (Spark has no server triggers). The doc id
    // is ticketNumber + sha256(ticketNumber:PIN), so holding the id IS the proof of
    // the PIN: a point get is the only public read, and there is no anonymous query
    // to enumerate. Online PIN guessing costs a billed read per attempt. Staff list
    // only to run the admin rebuild, which also deletes orphaned mirrors.
    match /repair_tracking/{mirrorId} {
      allow get:                    if true;
      allow list:                   if isSignedIn();
      allow write:                  if isSignedIn() &&
        (canWorkRepairs(callerProfile()) || canViewCustomers(callerProfile()));
    }

    // ─── Counters (for sequential numbers like TKT-XXXX) ──────────────────────
    // Invoice numbers are claimed by sellers, ticket numbers by intake.
    match /counters/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() &&
        (canSell(callerProfile()) || hasPerm(callerProfile(), 'repair_add'));
    }

    // ─── Customers ───────────────────────────────────────────────────────────
    // Walk-ins are created at the till and at intake; totals move on sales,
    // repairs and debt payments; the profile-edit unlock admits any staffer who
    // can open the customers page. Deletion stays admin-only.
    match /customers/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        (canSell(callerProfile()) || canWorkRepairs(callerProfile()) ||
         canManageDebt(callerProfile()) || canViewCustomers(callerProfile()));
      allow delete:               if isAdmin() || isSuperAdmin();
    }

    // ─── Customer Debts & Credit Tabs ────────────────────────────────────────
    // Credit sales (pos/parts_sell), repair settlements and intake down payments
    // (repair flags) and debt-tab payments (customers_debt) all write here; a
    // credit-sale refund zeroes the balance from the till, so sellers update too.
    // Deletion stays admin-only.
    match /customer_debts/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        (canSell(callerProfile()) || canManageDebt(callerProfile()) || canWorkRepairs(callerProfile()));
      allow delete:               if isAdmin() || isSuperAdmin();
    }

    // ─── Customer Activity Logs ──────────────────────────────────────────────
    // Immutable audit trail for customer ledger & events.
    // The only permitted edit is re-pointing a log at another customer id, which is what
    // merging two duplicate customers does; amounts, actions and timestamps stay frozen.
    match /customer_activity_logs/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerId', 'customerName']);
      allow delete: if false;
    }

    // ─── Activity Logs ───────────────────────────────────────────────────────
    // Anyone signed-in can create; the trail cannot be edited by anyone.
    // Deletion exists only as the admin retention purge, and only for logs that are already
    // past the window it keeps. The window is 85 days rather than the purge's 90 so a till
    // with a slightly fast clock does not fail the whole batch.
    match /activityLogs/{docId} {
      allow read:          if isSignedIn();
      allow create:        if isSignedIn();
      allow update:        if false;
      allow delete:        if (isAdmin() || isSuperAdmin()) &&
        resource.data.timestamp < request.time - duration.value(85, 'd');
    }

    // ─── Purchasing & Suppliers ──────────────────────────────────────────────
    // The purchasing page requires inventory_edit. The parts restock assistant
    // also raises purchase orders, so parts staff (inventory_parts) may write
    // POs — but supplier records stay with the purchasing editors.
    match /suppliers/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && hasPerm(callerProfile(), 'inventory_edit');
    }

    match /purchaseOrders/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() &&
        (hasPerm(callerProfile(), 'inventory_edit') || hasPerm(callerProfile(), 'inventory_parts'));
    }

    // ─── Restock & Write-Off Logs ────────────────────────────────────────────
    match /restockLogs/{docId} {
      allow read:          if isSignedIn();
      allow create:        if isSignedIn();
      allow update, delete: if false;
    }

    match /writeOffLogs/{docId} {
      allow read:          if isSignedIn();
      allow create:        if isSignedIn();
      allow update, delete: if false;
    }

    // ─── User Profiles ───────────────────────────────────────────────────────
    // Workers can only read. Only admins/superadmins can write.
    // Strict rules prevent privilege escalation:
    //   - Nobody can grant isSuperAdmin via the API (only existing super admins can)
    //   - Regular admins cannot promote anyone to admin role
    match /users/{userId} {
      // Anyone signed-in can read staff profiles (needed for listings)
      allow read: if isSignedIn();

      // Prevent privilege escalation on creation:
      // Non-admins can only create non-admin profiles for their own UID
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isAdmin() ||
        (request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false))
      );

      // Updates:
      // 1. Super Admins can do anything
      // 2. Admins can edit with strict guards (cannot grant superadmin or promote to admin)
      // 3. Workers can self-update personal fields (pushToken, preferredLanguage, avatar)
      //    WITHOUT being able to alter role, permissions, isSuperAdmin, or approvalPin
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && (
          !('isSuperAdmin' in request.resource.data && request.resource.data.isSuperAdmin == true) &&
          !('role' in request.resource.data && request.resource.data.role == 'admin') &&
          !(resource != null && resource.data.isSuperAdmin == true)
        )) ||
        (request.auth.uid == userId && (
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false) &&
          (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions) &&
          (!('approvalPin' in request.resource.data) || request.resource.data.approvalPin == resource.data.approvalPin)
        ))
      );

      // Only Super Admins can delete user profiles
      allow delete: if isSignedIn() && isSuperAdmin();

      // Approval PIN verifiers live OFF the broadly-readable profile: a 4–8 digit
      // PIN is brute-forceable offline once read, so only the owner and admins may
      // read a verifier. Writes mirror the staff editor: self, a true super admin,
      // or an admin managing a non-super profile (never the owner's PIN).
      match /secrets/{secretId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
        allow write: if isSignedIn() && (
          request.auth.uid == userId ||
          callerProfile().get('isSuperAdmin', false) == true ||
          (isAdmin() &&
           get(/databases/$(database)/documents/users/$(userId)).data.get('isSuperAdmin', false) != true)
        );
      }
    }

    // ─── Active & Suspended Carts ────────────────────────────────────────────
    // Signed-in users can read/write their own active & suspended carts
    match /carts/{docId} {
      allow read, write: if isSignedIn();
    }

    match /suspended_carts/{docId} {
      allow read, write: if isSignedIn();
    }

    match /parts_suspended_carts/{docId} {
      allow read, write: if isSignedIn();
    }

    // ─── Settings ────────────────────────────────────────────────────────────
    // `settings/general` is the single document the customer tracking page reads without a
    // session (store name, currency, WhatsApp contact). Other settings documents, and any
    // unauthenticated listing of the collection, require a signed-in staff session.
    // Only Admins/SuperAdmins can WRITE settings (changing IP config etc.)
    match /settings/general {
      allow get: if true;
      allow read, write: if isAdmin() || isSuperAdmin();
    }

    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() || isSuperAdmin();
    }

    // ─── Approval Requests ────────────────────────────────────────────────────
    // Signed-in staff can create pending requests; only admins can resolve/approve/reject them
    match /approvalRequests/{docId} {
      allow read: if isSignedIn();
      // Workers can only create pending requests for their own account
      allow create: if isSignedIn() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedBy.uid == request.auth.uid;
      // Only admins or superadmins can approve/reject. Requesters can only cancel their own pending request.
      allow update: if isSignedIn() && (
        isAdmin() || isSuperAdmin() ||
        (request.resource.data.status == 'cancelled' && resource.data.requestedBy.uid == request.auth.uid)
      );
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ─── End Of Day ──────────────────────────────────────────────────────────
    // Sealing a day runs on whichever till is open, by hand or at midnight, so any signed-in
    // user may create one. A sealed record is not meant to be rewritten: staff may only edit
    // `notes`, while admins (who also run backup restore) may correct a record.
    match /end_of_day/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isSuperAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']);
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ─── Remote Print Queue ──────────────────────────────────────────────────
    // One device pushes a job, the till that owns the printer claims it and reports the
    // outcome. Both are signed-in sessions. Without these rules the queue listener was
    // denied on every mount and remote printing never ran.
    match /printQueue/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // pending -> processing -> completed / failed
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ─── Server-Side Enforcement (Cloud Functions) ───────────────────────────
    // Written only by the functions, which hold admin privileges and bypass these rules.
    // A till may read its violations but never write one, or the log stops being evidence.
    match /moneyPathViolations/{docId} {
      allow read:  if isAdmin() || isSuperAdmin();
      allow write: if false;
    }

    // The per-date lock that keeps "one seal per day" true even when two tills close at once.
    match /eod_seal_locks/{date} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ─── Deny Everything Else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
