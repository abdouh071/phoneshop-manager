{
  "name": "phoneshop-manager-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side enforcement of the PhoneShop Manager Pro money path: approval PIN verification, one seal per day, and invariant guards.",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check": "node --check index.js && node --check lib/invariants.js",
    "test": "node --test lib/*.test.js",
