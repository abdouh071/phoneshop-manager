# ── Print Server Configuration ──────────────────────────────────────────
# Run `lpstat -p -d` in Terminal to find your CUPS queue names.
# Every value below is optional; the defaults are the secure ones.

# Which queue receives ESC/POS receipts and which receives TSPL labels.
PRINTER_NAME=XP_T80Q
LABEL_PRINTER_NAME=Xprinter_XP_420B

# Cut the paper after each receipt. Set false for printers with no cutter.
HAS_CUTTER=true

# Shift labels left (in dots) to compensate for the printer's own margin.
LABEL_OFFSET_X=12

# Port the loopback server listens on.
PORT=3355

# ── Network exposure ────────────────────────────────────────────────────
# The server binds to 127.0.0.1 so only this machine can reach it. Remote
# till-to-till printing already goes through the Firestore printQueue, so
# LAN mode is not needed for normal operation.
# Set to 1 ONLY when a device on the shop network must POST directly.
PRINT_SERVER_LAN_MODE=0
# Explicit bind address; overrides the LAN_MODE default.
# PRINT_SERVER_HOST=127.0.0.1
# Allow origins whose host is a private range (192.168/10./172.16-31, .local).
# Defaults to PRINT_SERVER_LAN_MODE.
# PRINT_SERVER_TRUST_PRIVATE_ORIGINS=0

# Extra browser origins, comma-separated, that may print from this machine.
# The hosted app origin is always allowlisted; localhost always passes.
# PRINT_SERVER_ALLOWED_ORIGINS=https://till.example.com,http://192.168.1.40:5173

# ── Authorization ───────────────────────────────────────────────────────
# Browsers are authorized by their Origin. Non-browser clients (curl, a
# script, another service) must send:  X-Print-Token: <token>
# Leave unset and the server generates one at ~/.phone-shop-print-server/token
# (0600) and prints the path at startup — never the value.
# PRINT_SERVER_TOKEN=

# Escape hatch: disable all authorization. Not recommended.
# PRINT_SERVER_ALLOW_UNAUTHENTICATED=0

# ── Limits (paper-charge / memory guards) ───────────────────────────────
# PRINT_SERVER_MAX_COPIES=25
# PRINT_SERVER_MAX_LABELS_PER_JOB=120
# PRINT_SERVER_MAX_TEXT_LEN=4096
# PRINT_SERVER_MAX_ARRAY_LEN=1000
# PRINT_SERVER_MAX_LOGO_PIXELS=4000000
# PRINT_SERVER_MAX_QUEUE_DEPTH=12
# PRINT_SERVER_BODY_LIMIT=2mb

# ── Reliability ─────────────────────────────────────────────────────────
# How long a CUPS command may hang before the job fails instead of blocking.
# PRINT_SERVER_LPR_TIMEOUT_MS=20000
# PRINT_SERVER_CUPS_QUERY_TIMEOUT_MS=5000
# Never fall back to the system default printer. When the configured queue is
# missing, the server returns 502 and names the queue to fix. Set 1 to allow
# the fallback (risk: printing to the wrong physical printer).
# PRINT_SERVER_ALLOW_DEFAULT_PRINTER=0

# ── Rate limiting ───────────────────────────────────────────────────────
# PRINT_SERVER_RATE_WINDOW_MS=60000
# PRINT_SERVER_RATE_MAX_JOBS=40
