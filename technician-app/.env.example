# Technician App Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials.
# Every key is optional: src/lib/firebase.ts falls back to the phoneshop-mgr-pro-2026 values.
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Leave EXPO_PUBLIC_FIREBASE_APP_ID unset unless you must force one Firebase app.
# When it is unset the app id resolves per platform — the Android id from
# google-services.json on Android, the web id elsewhere.
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: only set these once a key restricted to the matching platform
# package/bundle id has been tested against a real build. Unrestricted requests
# from React Native are rejected by a platform-restricted key, so the general
# web key above stays the default.
# EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=
# EXPO_PUBLIC_FIREBASE_IOS_API_KEY=

# EAS project id used to exchange the device push token for an Expo push token.
# Find it with `eas project:info`.
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id
